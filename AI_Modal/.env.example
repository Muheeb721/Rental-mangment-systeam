# Copy to .env and fill in. Never commit .env.

# --- LLM (any OpenAI-compatible chat-completions API) ---
# Leave LLM_API_KEY empty to run with template replies only.
# Examples:
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
#   Groq        LLM_BASE_URL=https://api.groq.com/openai/v1    LLM_MODEL=openai/gpt-oss-120b
#   xAI Grok    LLM_BASE_URL=https://api.x.ai/v1               LLM_MODEL=grok-4-fast
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1      LLM_MODEL=openai/gpt-4o-mini
#   Gemini      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
#   Ollama      LLM_BASE_URL=http://localhost:11434/v1         LLM_MODEL=llama3.1   (any non-empty key)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
LLM_REASONING_EFFORT=auto
USE_LLM=1

# --- data ---
MONGODB_URI=mongodb://127.0.0.1:27018/rms
PROPERTY_COLLECTION=properties
CATALOG_TTL_SECONDS=60

# --- service ---
PORT=8000
MAX_PROPERTIES=6
USE_NLP_MODEL=1
PETROL_PRICE_PKR=265
